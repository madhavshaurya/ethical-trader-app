# Server-side key for the AI assistant (NVIDIA NIM).
# https://build.nvidia.com — never expose this to the client.
NVIDIA_API_KEY=

# Public access key for contact-form submissions.
# https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional. Overrides the canonical origin used by metadata, canonicals, the sitemap,
# robots.txt, JSON-LD and the Markdown served to agents. Set this on staging domains.
# No trailing slash. Defaults to https://theethicaltrader.in
# NEXT_PUBLIC_SITE_URL=
